<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.example</groupId>
	<artifactId>recruitment-processing-platform</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>RecruitmentProcessingPlatform</name>
	<description>Bulk Recruitment Processing Platform</description>
	<properties>
		<java.version>17</java.version>
		<!-- Overridable default: mvn test -DexcludedGroups= -Dgroups=benchmark
		     runs the excluded benchmark tests instead. A literal value here
		     (rather than this property reference) would NOT be overridable
		     by -D on the command line at all - Maven only lets -D win over a
		     ${property} placeholder, never over a hardcoded literal. -->
		<excludedGroups>benchmark</excludedGroups>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>

		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>
		<!-- Apache POI reads the .xlsx candidate spreadsheet. poi-ooxml pulls in
		     the base poi artifact transitively, so one dependency is enough.
		     Not part of Spring Boot's managed dependency BOM, so we pin an
		     explicit version. -->
		<dependency>
			<groupId>org.apache.poi</groupId>
			<artifactId>poi-ooxml</artifactId>
			<version>5.5.1</version>
		</dependency>
		<!-- Like spring-boot-starter-data-jpa and -webmvc, this pulls in both
		     the library (spring-kafka) and Spring Boot's autoconfiguration
		     for it (the KafkaTemplate/KafkaAdmin beans, spring.kafka.*
		     properties support). Plain spring-kafka alone is NOT enough -
		     without the starter, none of that autoconfiguration exists and
		     no KafkaTemplate bean ever gets created. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-kafka</artifactId>
		</dependency>
		<!-- spring-kafka's JsonSerializer/JsonDeserializer (used for our
		     CandidateProcessingEvent messages) are built on classic Jackson
		     2's ObjectMapper/JavaType, not Spring Boot 4's own Jackson 3
		     (tools.jackson.*) - the two Jackson major versions coexist
		     under different Maven coordinates. Without this, the app
		     starts fine under `mvn test` (some test-scope dependency
		     happens to pull classic Jackson 2 in transitively, masking the
		     gap) but fails at actual runtime with a NoClassDefFoundError
		     the moment the Kafka listener container tries to construct a
		     consumer - caught by actually running the app, not just the
		     test suite. Version pinned to match what was already resolving
		     at test scope. -->
		<dependency>
			<groupId>com.fasterxml.jackson.core</groupId>
			<artifactId>jackson-databind</artifactId>
			<version>2.21.5</version>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- Provides @EmbeddedKafka: a real, in-process Kafka broker for tests -
		     no Docker or external broker needed to prove messages actually
		     reach a topic. -->
		<dependency>
			<groupId>org.springframework.kafka</groupId>
			<artifactId>spring-kafka-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
			<!-- reuseForks=false: give every test class its own fresh JVM.
			     Discovered why this matters the hard way - two test classes
			     that each start an embedded Kafka broker in their own Spring
			     context (ProcessingJobControllerTest's and
			     CandidateProcessingFailureTest's @MockitoSpyBean forces a
			     distinct context from the rest) interfered with each other
			     when Surefire reused one JVM across both: the second
			     broker/consumer group came up but never actually received
			     any messages, even though each test passes cleanly alone.
			     Root-causing exactly why two independent embedded KRaft
			     brokers collide inside one JVM wasn't worth chasing further -
			     process-level isolation is the standard, well-understood fix
			     for exactly this class of problem. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<reuseForks>false</reuseForks>
					<forkCount>1</forkCount>
					<!-- Step 9's benchmark tests (@Tag("benchmark")) are real but
					     slow - a 100k-candidate run takes real wall-clock minutes.
					     Excluded from the default `mvn test` so ordinary
					     development iteration stays fast; run them explicitly
					     with `mvn test -DexcludedGroups= -Dgroups=benchmark`. -->
					<excludedGroups>${excludedGroups}</excludedGroups>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>
